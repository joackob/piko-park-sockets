---
import Layout from "@layouts/Layout.astro";
---

<Layout>
  <h1>Piko park</h1>
  <canvas piko-park-canvas></canvas>
  <script>
    import { MotorFisico } from "@motor/motor";
    import { ConexionWS } from "@conexion/conexion_ws";

    const lienzos = document.querySelectorAll<HTMLCanvasElement>(
      `canvas[piko-park-canvas]`,
    );
    lienzos.forEach((lienzo) => {
      const motor = new MotorFisico({
        lienzo,
      });

      motor.comenzar();

      const conexion = new ConexionWS({
        ws: new WebSocket("ws://localhost:3000/ws"),
      });

      conexion
        .alConectarseAlServidor(() => {
          console.log("Conectado...");
        })
        .alConectarseUnJugador(({ id }) => {
          motor.agregarPersonaje({ id });
        })
        .alRecibirUnaSolicitudDeSalto(({ id }) => {
          motor.aplicarSaltoAUnPersonaje({ id });
        });
    });
  </script>
</Layout>
